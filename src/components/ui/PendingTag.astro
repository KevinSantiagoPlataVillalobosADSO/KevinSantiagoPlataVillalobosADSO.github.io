---
/** Marca visible para contenido de ejemplo que debe reemplazarse. */
interface Props {
  label?: string;
}
const { label = 'Contenido de ejemplo' } = Astro.props;
---

<span class="pending mono">
  <span class="pending__mark" aria-hidden="true"></span>
  {label}
</span>

<style>
  .pending {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    padding: 0.3rem 0.6rem;
    border: 1px dashed rgb(255 106 61 / 0.45);
    border-radius: var(--radius-pill);
    color: var(--accent);
    font-size: 0.6875rem;
    white-space: nowrap;
  }

  .pending__mark {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: currentColor;
  }
</style>

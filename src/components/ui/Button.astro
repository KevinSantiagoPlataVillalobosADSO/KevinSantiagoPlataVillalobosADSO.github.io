---
import Icon from './Icon.astro';
import type { IconName } from '@/lib/icons';
import { isExternal } from '@/lib/url';

interface Props {
  href: string;
  label: string;
  variant?: 'primary' | 'ghost';
  icon?: IconName;
  download?: boolean;
  class?: string;
}

const { href, label, variant = 'primary', icon, download, class: className } = Astro.props;
const external = isExternal(href);
---

<a
  href={href}
  class:list={['btn', `btn--${variant}`, className]}
  data-icon={icon}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  download={download ? '' : undefined}
>
  <span class="btn__label">
    <span class="btn__text">{label}</span>
    <span class="btn__text btn__text--clone" aria-hidden="true">{label}</span>
  </span>
  {
    icon && (
      <span class="btn__icon">
        <Icon name={icon} size={16} strokeWidth={1.75} />
      </span>
    )
  }
  {external && <span class="sr-only">(se abre en una pestaña nueva)</span>}
</a>

<style>
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 3.25rem;
    padding: 0 1.25rem 0 1.5rem;
    border-radius: var(--radius-pill);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: -0.005em;
    white-space: nowrap;
    transition:
      transform var(--dur-press) var(--ease-out),
      background-color var(--dur-ui) ease,
      color var(--dur-ui) ease,
      border-color var(--dur-ui) ease;
  }

  /* Feedback de pulsación: también real en táctil, no necesita gating */
  .btn:active {
    transform: scale(0.97);
  }

  .btn--primary {
    background: var(--fg);
    color: var(--bg);
  }

  .btn--ghost {
    border: 1px solid var(--line-strong);
    color: var(--fg);
  }

  /* Texto que rueda: dos copias, la segunda solo visual */
  .btn__label {
    position: relative;
    display: block;
    overflow: hidden;
    height: 1.3em;
    line-height: 1.3;
  }

  .btn__text {
    display: block;
    transition: transform var(--dur-hover) var(--ease-out);
  }

  .btn__text--clone {
    position: absolute;
    inset: 100% 0 auto 0;
  }

  .btn__icon {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    margin-right: -0.5rem;
    border-radius: 50%;
    transition:
      transform var(--dur-ui) var(--ease-out),
      background-color var(--dur-ui) ease;
  }

  .btn--primary .btn__icon {
    background: rgb(14 14 12 / 0.08);
  }

  .btn--ghost .btn__icon {
    background: var(--line);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn:hover .btn__text {
      transform: translateY(-100%);
    }

    .btn--primary:hover {
      background: var(--accent);
      color: var(--accent-ink);
    }

    .btn--ghost:hover {
      border-color: var(--fg-muted);
    }

    .btn[data-icon='arrow-down']:hover .btn__icon {
      transform: translateY(2px);
    }

    .btn[data-icon='arrow-up-right']:hover .btn__icon {
      transform: translate(2px, -2px);
    }

    .btn[data-icon='download']:hover .btn__icon {
      transform: translateY(2px);
    }
  }

  /* Movimiento reducido: se conserva el cambio de color, se elimina el desplazamiento */
  @media (prefers-reduced-motion: reduce) {
    .btn:hover .btn__text,
    .btn[data-icon]:hover .btn__icon {
      transform: none;
    }
  }
</style>

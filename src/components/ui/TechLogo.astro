---
import { techIcons } from '@/lib/icons';
import type { Tech } from '@/data/stack';

interface Props {
  tech: Tech;
  class?: string;
}

const { tech, class: className } = Astro.props;
const logo = tech.icon ? techIcons[tech.icon] : undefined;
const abbr = tech.abbr ?? tech.name.replace(/[^\p{L}\p{N}]/gu, '').slice(0, 3);
---

{
  logo ? (
    <svg
      class:list={['tech-logo', className]}
      viewBox="0 0 24 24"
      aria-hidden="true"
      focusable="false"
    >
      <path d={logo.path} fill="currentColor" />
    </svg>
  ) : (
    <span class:list={['tech-logo', 'tech-logo--abbr', className]} aria-hidden="true">
      {abbr}
    </span>
  )
}

<style>
  .tech-logo {
    flex: none;
    width: 1.375rem;
    height: 1.375rem;
  }

  .tech-logo--abbr {
    display: grid;
    place-items: center;
    width: auto;
    min-width: 1.375rem;
    padding-inline: 0.2rem;
    border: 1px solid currentColor;
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1;
  }
</style>

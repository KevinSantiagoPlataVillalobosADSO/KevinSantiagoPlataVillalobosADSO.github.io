---
import { Image } from 'astro:assets';
import Section from '@/components/layout/Section.astro';
import SplitWords from '@/components/ui/SplitWords.astro';
import { profile } from '@/data/profile';
import { portrait, portraitAlt } from '@/data/media';

const { about } = profile;
---

<Section id="sobre-mi" meta="Quién soy" class="about">
  <SplitWords text={about.statement} mode="light" class="about__statement" />

  <div class="about__grid">
    <figure class="about__portrait" data-reveal="clip">
      {
        portrait ? (
          <Image
            src={portrait}
            alt={portraitAlt}
            widths={[480, 800, 1200]}
            sizes="(min-width: 64rem) 30vw, 90vw"
            class="about__photo"
          />
        ) : (
          <div class="about__placeholder">
            <span class="about__crop" aria-hidden="true" />
            <span class="mono">Tu foto aquí</span>
            <span class="mono about__hint">4:5 · src/data/media.ts</span>
          </div>
        )
      }
    </figure>

    <div class="about__content">
      <div class="about__blocks">
        {
          about.blocks.map((block, i) => (
            <div class="about__block" data-reveal data-delay={String(i)}>
              <h3 class="mono about__block-title">{block.title}</h3>
              <p>
                {block.body}
                {block.link && (
                  <>
                    {' '}
                    <a class="link about__inline-link" href={block.link.href}>
                      {block.link.label}
                    </a>
                  </>
                )}
              </p>
            </div>
          ))
        }
      </div>

      <div class="about__interests" data-reveal>
        <h3 class="mono about__block-title">Lo que me gusta resolver</h3>
        <ul>
          {about.interests.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="about__principles">
        <h3 class="mono about__block-title" data-reveal>Filosofía</h3>
        <ol>
          {
            about.principles.map((p, i) => (
              <li class="principle" data-reveal data-delay={String(i)}>
                <span class="principle__num serif" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <p class="principle__title">{p.title}</p>
                  <p class="principle__body">{p.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</Section>

<script>
  import { initWordLight } from '@/scripts/word-light';
  initWordLight();
</script>

<style>
  .about :global(.about__statement) {
    max-width: 22ch;
    font-size: var(--step-3);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: pretty;
  }

  @media (min-width: 64rem) {
    .about :global(.about__statement) {
      max-width: 24ch;
      font-size: clamp(2.5rem, 1rem + 3.6vw, 4.75rem);
    }
  }

  .about__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 4rem;
    margin-top: clamp(4rem, 3rem + 6vw, 9rem);
  }

  /* ── Retrato ─────────────────────────────────────────────── */
  .about__portrait {
    grid-column: 1 / span 4;
    align-self: start;
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-s);
    background: var(--bg-elev);
  }

  .about__portrait :global(.about__photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about__placeholder {
    position: relative;
    display: grid;
    place-content: center;
    gap: 0.5rem;
    height: 100%;
    text-align: center;
    color: var(--fg-muted);
    background:
      radial-gradient(120% 80% at 30% 20%, rgb(255 106 61 / 0.1), transparent 60%),
      repeating-linear-gradient(
        135deg,
        transparent 0 14px,
        rgb(239 236 228 / 0.025) 14px 15px
      );
  }

  .about__hint {
    color: var(--fg-faint);
    font-size: 0.625rem;
  }

  /* Marcas de corte en las esquinas */
  .about__crop {
    position: absolute;
    inset: 1rem;
    pointer-events: none;
    background:
      linear-gradient(var(--fg-faint), var(--fg-faint)) top left / 14px 1px,
      linear-gradient(var(--fg-faint), var(--fg-faint)) top left / 1px 14px,
      linear-gradient(var(--fg-faint), var(--fg-faint)) top right / 14px 1px,
      linear-gradient(var(--fg-faint), var(--fg-faint)) top right / 1px 14px,
      linear-gradient(var(--fg-faint), var(--fg-faint)) bottom left / 14px 1px,
      linear-gradient(var(--fg-faint), var(--fg-faint)) bottom left / 1px 14px,
      linear-gradient(var(--fg-faint), var(--fg-faint)) bottom right / 14px 1px,
      linear-gradient(var(--fg-faint), var(--fg-faint)) bottom right / 1px 14px;
    background-repeat: no-repeat;
  }

  /* ── Contenido ───────────────────────────────────────────── */
  .about__content {
    grid-column: 6 / -1;
    display: grid;
    gap: clamp(3.5rem, 2.5rem + 4vw, 6rem);
  }

  .about__blocks {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem var(--gap);
  }

  .about__block p {
    color: var(--fg-muted);
  }

  .about__block-title {
    margin-bottom: 1rem;
    color: var(--fg);
  }

  .about__inline-link {
    color: var(--fg);
  }

  .about__interests ul {
    border-top: 1px solid var(--line);
  }

  .about__interests li {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--step-1);
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .about__interests li::before {
    content: '';
    flex: none;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--accent);
    transform: translateY(-0.2em);
  }

  .about__principles ol {
    display: grid;
    gap: 2rem;
  }

  .principle {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .principle__num {
    font-size: var(--step-3);
    line-height: 0.9;
    color: var(--accent);
  }

  .principle__title {
    font-size: var(--step-2);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .principle__body {
    margin-top: 0.5rem;
    color: var(--fg-muted);
  }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 63.99rem) {
    .about__portrait {
      grid-column: 1 / span 5;
    }

    .about__content {
      grid-column: 6 / -1;
    }

    .about__blocks {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 47.99rem) {
    .about__portrait {
      position: relative;
      top: 0;
      grid-column: 1 / span 9;
    }

    .about__content {
      grid-column: 1 / -1;
    }

    .principle {
      grid-template-columns: 3rem minmax(0, 1fr);
    }
  }
</style>

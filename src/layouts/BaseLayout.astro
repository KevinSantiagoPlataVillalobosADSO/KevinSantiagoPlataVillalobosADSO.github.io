---
import { Font } from 'astro:assets';
import '@/styles/global.css';
import Seo from '@/components/layout/Seo.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Cursor from '@/components/layout/Cursor.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  home?: boolean;
}

const { title, description, noindex = false, home = true } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Marca que hay JS antes del primer pintado: evita parpadeos en los reveals -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <Font cssVariable="--font-geist" preload={[{ subset: 'latin' }]} />
    <Font cssVariable="--font-instrument" preload={[{ subset: 'latin', style: 'italic' }]} />
    <Font cssVariable="--font-geist-mono" />
    <Seo title={title} description={description} noindex={noindex} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header home={home} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer home={home} />
    <Cursor />
    <script>
      import { initReveal } from '@/scripts/reveal';
      initReveal();
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
